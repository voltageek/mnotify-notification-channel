{
    "name": "voltageek/mnotify-notification-channel",
    "description": "MNotify Notification Channel for laravel.",
    "keywords": ["laravel", "notifications", "mnotify", "sms"],
    "license": "MIT",
    "authors": [
        {
            "name": "Kwame Nkansah",
            "email": "kwame.nkansah@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/notifications": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.2",
        "mockery/mockery": "^1.0",
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^9.0|^10.4|^11.5"
    },
    "autoload": {
        "psr-4": {
            "Cactus\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cactus\\Notifications\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cactus\\Notifications\\MNotifyChannelServiceProvider"
            ],
            "aliases": {
                "MNotify": "Cactus\\Notifications\\Facades\\MNotify"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
